{
  "expo": {
    "name": "Viscera",
    "slug": "Viscera",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Viscera_Logo.png",
    "scheme": "viscera",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.viscera.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Viscera requires camera access to take profile photos and scan healthcare license and verification documents.",
        "NSPhotoLibraryUsageDescription": "Viscera requires photo library access to select and upload your profile picture and medical certification documents.",
        "NSPhotoLibraryAddUsageDescription": "Viscera requires access to save downloaded documents and confirmation receipts to your photo library."
      }
    },
    "android": {
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "INTERNET",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "edgeToEdgeEnabled": false,
      "androidNavigationBar": {
        "visible": "always",
        "backgroundColor": "#ffffff",
        "barStyle": "dark-content"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.viscera.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#2563EB"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Viscera requires photo library access to allow you to upload your profile avatar and medical certification documents.",
          "cameraPermission": "Viscera requires camera access to take profile photos and scan your healthcare licenses."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f2529079-93a8-4e9e-a5dc-aa1b2f921505"
      }
    },
    "owner": "kananshahs-team"
  }
}
